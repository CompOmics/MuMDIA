{
  "convert": {
    "isolation_half_width": 1.9
  },
  "features": {
    "set": "extended",
    "q1_fragment_features": true
  },
  "extract": {
    "apex_rt_prior_s": 120.0,
    "gate_min_score": 0.6,
    "q1_fragments": true
  },
  "retrace": {
    "q1_repick": true
  },
  "rt_im_train": {
    "rt_window_multiplier": 1.5,
    "q1_calibrate": true
  },
  "predict_frag": {
    "deeplc_python": "auto",
    "sidecar_script_dir": "scripts"
  },
  "rescore": {
    "classifier": "nn_torch",
    "python": "auto",
    "strict": true,
    "shadow_q1": true
  },
  "quant": {
    "q_filter": "run_psm_q",
    "q1_cycle_halfwidth": 4
  }
}
