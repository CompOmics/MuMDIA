# Build output for the desktop workspace.
target/

# Engine and installer binaries staged into the bundle by CI, never committed:
# they are build artifacts of another workspace and are megabytes each.
src-tauri/binaries/*
!src-tauri/binaries/README.md
!src-tauri/binaries/scripts/
# The workers are build-time copies of the top-level scripts/ (see scripts/README.md
# beside them); only that README is tracked, so a stale local copy cannot be committed.
src-tauri/binaries/scripts/*
!src-tauri/binaries/scripts/README.md

# Tauri writes generated permission schemas here.
src-tauri/gen/
src-tauri/resources/
